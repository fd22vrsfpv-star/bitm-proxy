# macOS resource forks
._*
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node
node_modules/
frontend/dist/

# Build artifacts
# (static/ is intentionally checked in so production installs don't
# need node/npm to serve the dashboard SPA.)
_build/
.local/

# Certs (user-specific)
certs/*.crt
certs/*.pem
certs/*.cer

# Config (contains webhook secrets)
config/config.json
config/slack_*.txt

# Claude Code local settings
.claude/

# agentic-security plugin scan artifacts (findings, scan history, etc.)
.agentic-security/

# Office lock/temp files (e.g. ~$deck.pptx while PowerPoint has it open)
~$*

# Presentation decks + their assets — kept out of the repo (distributed
# separately). Covers the root and docs/ copies.
DEFCON-RTV-2025-slides.*
docs/Grapnel-passkeys-RTV.*
docs/IGotIn-NowWhat*.pptx

# Talk recordings — 176-334 MB each, so each one is over GitHub's 100 MB
# per-file hard limit and can't be pushed. Distributed separately; the deck
# in rtv_talk/ is tracked.
rtv_talk/*.mp4

# Screenshots: ignore everything (raw dashboard captures carry lab-tenant
# identifiers / tokens) EXCEPT the hand-redacted set embedded in the README.
docs/screenshots/*
!docs/screenshots/captured-data-panels.png
!docs/screenshots/captured-data-list.png
!docs/screenshots/flow-trace.png
!docs/screenshots/index.png
!docs/screenshots/all-logs.png
!docs/screenshots/captured-data-attacks.png
!docs/screenshots/test-attacks-playbook.png
!docs/screenshots/flow-trace-test-timestamp.png
!docs/screenshots/settings-ado-defaults.png

# Data (runtime)
*.log

# IDE
.vscode/
.idea/

# Phantom Join / ROADtools — engagement-specific artifacts that must
# never land in git. See tools/README_Phantom.md.
.roadtools_auth*
roadtx.prt
*.rtdevice
roadrecon.db
roadrecon.db-journal
phantom_join_*/
*.intunewin
findings_*.json
